{
  "schemaVersion": 1,
  "id": "crankshaft",
  "provides": ["flywheel"],
  "version": "${version}",
  "name": "CrankShaft",
  "description": "Dual-backend (raw OpenGL + raw Vulkan) instanced rendering engine.",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.engine_room.flywheel.impl.FlywheelFabricCommon"
    ],
    "client": [
      "dev.engine_room.flywheel.impl.FlywheelFabric"
    ]
  },
  "mixins": [
    "flywheel.impl.mixins.json",
    "flywheel.impl.fabric.mixins.json",
    "flywheel.impl.sodium.mixins.json",
    "flywheel.backend.mixins.json"
  ],
  "accessWidener": "crankshaft.accesswidener",
  "depends": {
    "minecraft": "${minecraft_fabric_range}",
    "fabricloader": "${fabric_loader_range}",
    "fabric-api": "${fabric_api_range}"
  },
  "suggests": {
    "sodium": "${sodium_fabric_range}"
  },
  "breaks": {
    "entityculling": "<1.11.2",
    "sodium": [
      "<${sodium_minimum}",
      ">=${sodium_maximum}"
    ]
  }
}
