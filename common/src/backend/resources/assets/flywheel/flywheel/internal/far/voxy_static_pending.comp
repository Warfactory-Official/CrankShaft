layout(local_size_x = 128) in;
layout(location = 0) uniform uint _flw_staticCoverageFrame;
layout(location = 1) uniform uint _flw_staticPendingCount;

layout(std430, binding = 0) readonly restrict buffer PendingGroups {
    uvec4 _flw_staticPendingGroups[];
};
layout(std430, binding = 1) readonly restrict buffer CoverageFrames {
    uint _flw_staticCoverageFrames[];
};
struct PendingDrawCommand {
    uint count;
    uint instanceCount;
    uint firstIndex;
    uint baseVertex;
    uint baseInstance;
};
layout(std430, binding = 2) restrict buffer PendingCommands {
    PendingDrawCommand _flw_staticPendingCommands[];
};

// Publication handoff uses actual host depth. A native section already submitting this page owns its geometry.
void main() {
    uint at = gl_GlobalInvocationID.x;
    if (at >= _flw_staticPendingCount) return;
    uvec4 group = _flw_staticPendingGroups[at];
    _flw_staticPendingCommands[group.w].instanceCount =
            _flw_staticCoverageFrames[group.z] == _flw_staticCoverageFrame ? 0u : group.y;
}
