layout(local_size_x = 256) in;

layout(std140, binding = 8) uniform TerrainHiZUniforms {
    mat4 viewProjection;
    vec4 cameraPosAndPad;
    ivec4 cameraBlockPosAndPad;
};

const uint FACING_COUNT = 7u; // ModelQuadFacing.COUNT
const uint REGION_SIZE = 256u; // sections per CrankShaft region (8 x 4 x 8)
const uint COMMAND_STRIDE = 20u;
const uint MAX_COMMANDS_PER_REGION_MAIN = FACING_COUNT * REGION_SIZE; // 7 * 256 = 1792

// Scene UBO (7): 7 terrain device pointers + region count (Nvidium scheme; order matches runComputeTailForPass).
#ifdef _FLW_VK
layout(std430, binding = 0) restrict readonly buffer RegionInputBuf { uvec4 regionInput[]; };
layout(std430, binding = 1) restrict readonly buffer SectionDataBuf { uvec4 sectionData0[]; };
layout(std430, binding = 2) restrict readonly buffer RegionVisBuf { uint regionVis[]; };
layout(std430, binding = 3) restrict readonly buffer SectionVisBuf { uint sectionVis[]; };
layout(std430, binding = 4) restrict writeonly buffer CommandBuf { uint commandWords[]; };
layout(std430, binding = 5) restrict buffer DrawCountBuf { uint drawCountMain; uint drawCountTemporal; };
layout(std430, binding = 6) restrict readonly buffer RegionGeoBuf { uvec2 regionGeo[]; };
layout(std430, binding = 7) restrict writeonly buffer DrawDataBuf { uvec4 drawData[]; };
layout(std140, binding = 9) uniform TerrainRegionCount { uint regionCount; uint phase; uint _rcPad1; uint _rcPad2; };
#else
layout(std140, binding = 7) uniform TerrainSceneUbo {
    restrict readonly uvec4 *regionInput;
    restrict readonly uvec4 *sectionData0;      // 3 uvec4 / section, region-id-keyed
    restrict readonly uint *regionVis;
    restrict readonly uint *sectionVis;
    restrict writeonly uint *commandWords;      // per arena run: [first slot * MAX_COMMANDS_PER_REGION_MAIN * 5, ...)
    restrict uvec2 *regionCommandCount;
    restrict readonly uint *geometryMask;
    uint regionCount;                           // visible-region count (replaces regionInput.length())
    uint phase;
};
// atomicAdd takes a buffer variable, not a bindless dereference. [run first slot].x = the run's command count.
layout(std430, binding = 5) restrict buffer RunCommandCountBuf { uvec2 runCommandCount[]; };
#endif

struct SectionFields {
    uint baseElement;
    uint baseVertex;
    uint sliceMask;
    uint facingLo; // low 32 of the 56-bit facingList (faces for groups 0..3)
    uint facingHi; // high 24 of the facingList (faces for groups 4..6, top byte = isLocalIndex)
    uint vertexCount[7];
};
SectionFields decodeSection(uint regionId, uint s) {
    // REGION-ID-KEYED (persistent SSBO): base = regionId*(REGION_SIZE*3u)+s*3u; slot-keyed addressing reads stale data.
    uint base = regionId * (REGION_SIZE * 3u) + s * 3u;
    uvec4 b0 = sectionData0[base + 0u];
    uvec4 b1 = sectionData0[base + 1u];
    uvec4 b2 = sectionData0[base + 2u];
    SectionFields f;
    f.baseElement = b0.x;
    f.baseVertex = b0.y;
    f.facingLo = b0.z;
    f.facingHi = b0.w;
    f.sliceMask = b1.x;
    f.vertexCount[0] = b1.y;
    f.vertexCount[1] = b1.z;
    f.vertexCount[2] = b1.w;
    f.vertexCount[3] = b2.x;
    f.vertexCount[4] = b2.y;
    f.vertexCount[5] = b2.z;
    f.vertexCount[6] = b2.w;
    return f;
}

uint facingByte(SectionFields f, uint i) {
    return i < 4u ? (f.facingLo >> (i * 8u)) & 0xFFu
                  : (f.facingHi >> ((i - 4u) * 8u)) & 0xFFu;
}

#ifdef _FLW_VK
void emitGlobal(uint g, uint firstIndex, uint baseVertex, uint indexCount, uvec4 in4, uint regionId, uint slot) {
    uint baseWord = g * 5u;
    commandWords[baseWord + 0u] = indexCount;
    commandWords[baseWord + 1u] = 1u;
    commandWords[baseWord + 2u] = firstIndex;   // byte offset into the shared quad index
    commandWords[baseWord + 3u] = baseVertex;
    commandWords[baseWord + 4u] = g;            // baseInstance = the drawData index
    int ox = int(in4.x << 16) >> 16;
    int oz = int(in4.x) >> 16;
    int oy = int(in4.y << 16) >> 16;
    drawData[g * 2u + 0u] = uvec4(uint(ox), uint(oy), uint(oz), regionId << 8u);
    drawData[g * 2u + 1u] = uvec4(regionGeo[slot], 0u, 0u);
}
#else
// in4.w = first slot of this slot's same-arena run; baseInstance = slot (terrain_solid.vert reads regionInput by it).
void emitCommand(uint slot, uint runSlot, uint firstIndex, uint baseVertex, uint indexCount) {
    uint wi = runSlot * MAX_COMMANDS_PER_REGION_MAIN + atomicAdd(runCommandCount[runSlot].x, 1u);
    if (wi >= regionCount * MAX_COMMANDS_PER_REGION_MAIN) {
        return;
    }
    uint baseWord = wi * 5u;
    commandWords[baseWord + 0u] = indexCount;
    commandWords[baseWord + 1u] = 1u;
    commandWords[baseWord + 2u] = firstIndex;   // byte offset into the shared quad index
    commandWords[baseWord + 3u] = baseVertex;
    commandWords[baseWord + 4u] = slot;
}
#endif

void main() {
    uint slot = gl_WorkGroupID.x;
    if (slot >= regionCount) {
        return;
    }
    uvec4 in4 = regionInput[slot];
    if (in4.z == 0xFFFFFFFFu) {
        return;
    }
    uint regionId = in4.z;

    // Region occluded: no section of this slot emits; bail before per-section work.
    if (regionVis[slot] == 0u) {
        return;
    }

#ifdef _FLW_VK
    uvec2 geo = regionGeo[slot];
    if ((geo.x | geo.y) == 0u) {
        return;
    }
#endif

    uint s = gl_LocalInvocationID.x;
    uint visIndex = (regionId << 8u) | s;
    uint sv = sectionVis[visIndex] & 0xFFu;

    // phase 1: bit0 -> MAIN; phase 2: bit1 -> TEMPORAL.
    // Lanes diverge on emit; the final barrier + lane-0 count write is unconditional.
    bool newlyVisible = phase == 2u;
    bool emit = (sv & (newlyVisible ? 2u : 1u)) != 0u;
    if (emit) {
        SectionFields f = decodeSection(regionId, s);

    // Backface cull of facing-runs (bits = ModelQuadFacing ordinal; UNASSIGNED kept); mirrors the CPU oracle.
    ivec3 secChunk = ivec3(int(in4.x << 16) >> 16, int(in4.y << 16) >> 16, int(in4.x) >> 16)
            + ivec3((int(s) >> 5) & 0x7, int(s) & 0x3, (int(s) >> 2) & 0x7); // LocalSectionIndex XZY 3/2/3
    vec3 camRel = vec3(secChunk) * 16.0 - vec3(cameraBlockPosAndPad.xyz) - cameraPosAndPad.xyz;
    uint camMask = 1u << 6u;
    if (camRel.x <   0.0) camMask |= 1u << 0u;
    if (camRel.y <   0.0) camMask |= 1u << 1u;
    if (camRel.z <   0.0) camMask |= 1u << 2u;
    if (camRel.x > -16.0) camMask |= 1u << 3u;
    if (camRel.y > -16.0) camMask |= 1u << 4u;
    if (camRel.z > -16.0) camMask |= 1u << 5u;
    uint slices = camMask & f.sliceMask;
    if (slices != 0u) {

        uint groupVertexCount = 0u;
        uint runBaseVertex = f.baseVertex;
        uint firstIndex = f.baseElement;
        uint lastMaskBit = 0u;

        for (uint i = 0u; i <= FACING_COUNT; i++) {
            uint maskBit = 0u;
            uint vertexCount = 0u;
            if (i < FACING_COUNT) {
                vertexCount = f.vertexCount[i];
                if (vertexCount != 0u) {
                    uint facing = facingByte(f, i);
                    maskBit = (slices >> facing) & 1u;
                }
            }
            // Sodium addSharedIndexedDrawCommands: a zero-vertex facing does NOT break a run -- skip without flushing.
            if (i < FACING_COUNT && vertexCount == 0u) {
                continue;
            }

            if (maskBit == 0u) {
                if (lastMaskBit == 1u) {
                    uint indexCount = (groupVertexCount >> 2u) * 6u;
#ifdef _FLW_VK
                    uint cap = regionCount * MAX_COMMANDS_PER_REGION_MAIN;
                    if (newlyVisible) {
                        uint wi = atomicAdd(drawCountTemporal, 1u);
                        if (wi < cap) {
                            emitGlobal(cap + wi, firstIndex, runBaseVertex, indexCount, in4, regionId, slot);
                        }
                    } else {
                        uint wi = atomicAdd(drawCountMain, 1u);
                        if (wi < cap) {
                            emitGlobal(wi, firstIndex, runBaseVertex, indexCount, in4, regionId, slot);
                        }
                    }
#else
                    emitCommand(slot, in4.w, firstIndex, runBaseVertex, indexCount);
#endif
                    runBaseVertex += groupVertexCount;
                    groupVertexCount = 0u;
                }
                runBaseVertex += vertexCount;
            } else {
                groupVertexCount += vertexCount;
            }
            lastMaskBit = maskBit;
        }
    }
    }
}
