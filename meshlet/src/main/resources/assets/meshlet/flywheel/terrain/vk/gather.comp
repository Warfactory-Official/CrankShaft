#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer SrcWords {
    uint w[];
};
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer DstWords {
    uint w[];
};

layout(push_constant) uniform PushConstants {
    uint64_t srcAddr;
    uint64_t dstAddr;
    uint wordCount;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.wordCount) {
        return;
    }
    DstWords(pc.dstAddr).w[i] = SrcWords(pc.srcAddr).w[i];
}
