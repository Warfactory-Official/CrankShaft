#version 430 core
layout(local_size_x = 1) in;
layout(std430, binding = 2) readonly buffer Counts { uint count; uint overflow; uint maxLayers; uint pad; };
layout(std430, binding = 4) buffer Commands { uint commands[]; };
layout(std140) uniform _FlwReplayControl { uvec4 control; };
void main() {
    if (overflow != 0u || control.x >= maxLayers) {
        commands[control.y] = 0u;
        commands[control.y + 1u] = 0u;
        commands[control.y + 2u] = 0u;
    }
}
