#version 430 compatibility
layout(local_size_x=1) in;
const ivec3 workGroups=ivec3(1,1,1);
layout(std430,binding=3) buffer Counts { uint count; uint overflow; uint maxLayers; uint metadata; };
void main() {
    if(maxLayers<=2u && (metadata&0x80000000u)==0u) maxLayers=0u;
    else if(maxLayers>1u && (metadata&0x40000000u)==0u) overflow|=8u;
}
