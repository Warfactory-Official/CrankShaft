#version 430 compatibility
layout(local_size_x = 8, local_size_y = 8) in;
const vec2 workGroupsRender = vec2(1.0, 1.0);
uniform vec2 screenSize;
_FLW_ITERATION_LAYERS
_FLW_ITERATION_MATERIALS
layout(std430, binding = _FLW_SNAPSHOT_BINDING) buffer FlwCaptureDepth { float flw_captureDepth[]; };
_FLW_SORTED_BLEND_CLEAR_DECLARATION
void main() {
    _FLW_SORTED_BLEND_CLEAR
    if (!flw_oitActive) return;
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, uvec2(screenSize)))) return;
    uint offset = pixel.y * uint(screenSize.x) + pixel.x;
    flw_heads[offset] = 0xffffffffu;
    flw_captureDepth[offset] = 0.0;
    flw_materialHeads[offset] = 0xffffffffu;
    if (offset == 0u) { flw_count = 0u; flw_overflow = 0u; flw_maxLayers = 0u; flw_pad = 0u; flw_needsLight = 0u; }
}
