#version 430 core
layout(local_size_x=64) in;
layout(std430,binding=2) buffer Counts { uint count; uint overflow; uint maxLayers; uint pad; };
// CPU loop bound from an earlier frame's maxLayers; exceeded => whole frame native, as on pool overflow.
uniform uint bound;
layout(std430,binding=4) writeonly buffer Commands { uint command[]; };
void main() {
    uint layer = gl_LocalInvocationID.x;
    uint base = layer * 5u;
    bool over = maxLayers > bound;
    command[base] = layer == 0u || (overflow == 0u && !over && layer < maxLayers) ? 6u : 0u;
    if (layer == 0u && over) overflow |= 2u;
    command[base+1u] = 1u;
    command[base+2u] = 0u;
    command[base+3u] = 0u;
    command[base+4u] = 0u;
}
