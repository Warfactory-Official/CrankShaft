#version 430 core
layout(local_size_x=64) in;
layout(std430,binding=FLW_REPLAY_COUNTS) buffer Counts { uint count; uint overflow; uint maxLayers; uint pad; };
// CPU loop bound from an earlier frame's maxLayers; exceeded => whole frame native, as on pool overflow.
uniform uint bound;
layout(std430,binding=FLW_REPLAY_COMMANDS) writeonly buffer Commands { uint command[]; };
#if FLW_REPLAY_COMPUTES > 0
uniform uvec3 workGroups[FLW_REPLAY_COMPUTES];
#endif
void main() {
    uint layer = gl_GlobalInvocationID.x;
    if (layer >= bound) return;
    uint base = layer * uint(FLW_REPLAY_WORDS);
    bool over = maxLayers > bound;
    bool enabledLayer = layer == 0u || (overflow == 0u && !over && layer < maxLayers);
    command[base] = enabledLayer ? 6u : 0u;
    if (layer == 0u && over) overflow |= 2u;
    command[base+1u] = 1u;
    command[base+2u] = 0u;
    command[base+3u] = 0u;
    command[base+4u] = 0u;
#if FLW_REPLAY_COMPUTES > 0
    for (uint i = 0u; i < uint(FLW_REPLAY_COMPUTES); ++i) {
        uint dispatchBase = base + 5u + i * 3u;
        uvec3 groups = enabledLayer ? workGroups[i] : uvec3(0u);
        command[dispatchBase] = groups.x;
        command[dispatchBase+1u] = groups.y;
        command[dispatchBase+2u] = groups.z;
    }
#endif
}
