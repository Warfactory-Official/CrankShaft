#version 430 core
layout(local_size_x=64) in;
layout(std430,binding=2) readonly buffer Counts { uint count; uint overflow; uint maxLayers; uint pad; };
layout(std430,binding=3) writeonly buffer Commands { uint command[]; };
void main() {
    uint layer = gl_LocalInvocationID.x;
    uint base = layer * 5u;
    command[base] = layer == 0u || (overflow == 0u && layer < maxLayers) ? 6u : 0u;
    command[base+1u] = 1u;
    command[base+2u] = 0u;
    command[base+3u] = 0u;
    command[base+4u] = 0u;
}
